---
# 비밀값 템플릿입니다. 이 파일을 같은 폴더의 vault.yml 로 복사한 뒤
# 실제 값을 넣고 암호화하세요.
#
#   cd ansible
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   vi group_vars/all/vault.yml                    # 실제 값 입력
#   ansible-vault encrypt group_vars/all/vault.yml # 암호화 (비밀번호 입력)
#
# 암호화하면 내용이 $ANSIBLE_VAULT;1.1;AES256 형태로 바뀝니다.
# 실행할 때 --ask-vault-pass 를 붙이면 자동 복호화됩니다.
#
# ⚠️ 반드시 group_vars/all/ 안에 두세요.
#    group_vars/vault.yml 처럼 두면 'vault' 라는 그룹이 없어서 통째로 무시되고,
#    .env 배포 단계에서 "'django_db_password' is undefined" 로 실패합니다.
#
#   확인:  ansible-inventory --host django-01
#          → django_db_password 가 보이면 정상 로드된 것입니다.
#
# 주의: vault.yml 은 .gitignore 에 등록되어 있어 커밋되지 않습니다.
#      팀원끼리는 vault 비밀번호를 안전한 경로로 따로 공유하세요.

django_db_password: "여기에-DB-비밀번호"
django_hira_service_key: "여기에-HIRA-API-키"

# SES SMTP 자격증명 (IAM 액세스 키가 아니라 SES 콘솔에서 발급하는 별도 값)
# 아직 미발급이면 이 두 줄은 비워두거나 생략해도 됩니다
# (env.j2 가 default('') 처리하므로 배포는 실패하지 않고, 메일 기능만 비활성)
django_email_host_user: "여기에-SES-SMTP-사용자명"
django_email_host_password: "여기에-SES-SMTP-비밀번호"
