---
# 비밀값 템플릿입니다. 이 파일을 vault.yml 로 복사한 뒤 실제 값을 넣고 암호화하세요.
#
#   cp vault.yml.example vault.yml
#   vi vault.yml                          # 실제 값 입력
#   ansible-vault encrypt vault.yml       # 암호화 (비밀번호 입력)
#
# 암호화하면 내용이 $ANSIBLE_VAULT;1.1;AES256 형태로 바뀝니다.
# 실행할 때 --ask-vault-pass 를 붙이면 자동 복호화됩니다.
#
# 주의: vault.yml 은 .gitignore 에 등록되어 있어 커밋되지 않습니다.
#      팀원끼리는 vault 비밀번호를 안전한 경로로 따로 공유하세요.

django_db_password: "여기에-DB-비밀번호"
django_hira_service_key: "여기에-HIRA-API-키"
