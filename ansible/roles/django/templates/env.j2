{{ ansible_managed | comment }}
# PharmaFlow 운영 환경변수
# systemd 의 EnvironmentFile 로 읽히므로 따옴표/공백 없이 KEY=VALUE 형식만 사용합니다.
# 원본 참고: 앱 저장소의 .env.example

DJANGO_SECRET_KEY={{ django_secret_key }}
DJANGO_DEBUG={{ django_debug }}
DJANGO_ALLOWED_HOSTS={{ django_allowed_hosts | join(',') }}

DB_NAME={{ django_db_name }}
DB_USER={{ django_db_user }}
DB_PASSWORD={{ django_db_password }}
DB_HOST={{ django_db_host }}
DB_PORT={{ django_db_port }}

HIRA_SERVICE_KEY={{ django_hira_service_key | default('') }}

GUNICORN_BIND={{ django_gunicorn_bind }}
GUNICORN_WORKERS={{ django_gunicorn_workers }}
LOG_LEVEL={{ django_log_level }}
