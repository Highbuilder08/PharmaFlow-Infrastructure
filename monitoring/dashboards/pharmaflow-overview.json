      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (\n  rate(container_cpu_usage_seconds_total{\n    namespace=\"pharmaflow-dev\",\n    pod=~\"django-.*|pharmaflow-nginx-.*\",\n    container!=\"\",\n    container!=\"POD\"\n  }[5m])\n)\nand on(pod)\n(\n  kube_pod_status_phase{\n    namespace=\"pharmaflow-dev\",\n    pod=~\"django-.*|pharmaflow-nginx-.*\",\n    phase=\"Running\"\n  } == 1\n)",
          "legendFormat": "{{pod}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
