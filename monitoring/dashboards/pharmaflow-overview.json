          "editorMode": "code",
          "expr": "(\n  sum(rate(pharmaflow_dashboard_cache_requests_total{\n    job=\"django\",result=\"hit\"\n  }[5m])) or vector(0)\n)\n/\nclamp_min(\n  sum(rate(pharmaflow_dashboard_cache_requests_total{\n    job=\"django\",result=~\"hit|miss\"\n  }[5m])) or vector(0),\n  1e-9\n)",
          "legendFormat": "Hit Rate",
          "range": true,
          "refId": "A"
        }
