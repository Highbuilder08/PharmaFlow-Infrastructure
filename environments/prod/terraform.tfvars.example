admin_cidr   = "YOUR_PUBLIC_IP/32"
ec2_key_name = "YOUR_EC2_KEY_PAIR_NAME"

db_name     = "pharmaflow"
db_username = "YOUR_DB_USERNAME"
db_password = "YOUR_DB_PASSWORD"

domain_name = "example.com"
alert_email = "REPLACE-WITH-ALERT-EMAIL"

# Pin the validated Ubuntu 24.04 AMI used by legacy EC2 instances.
# Upgrade this value intentionally after testing a newer AMI.
ubuntu_ami_id = "REPLACE-WITH-VALIDATED-UBUNTU-24.04-AMI-ID"
