*.tfplan

# Sensitive files
.env
.env.*
*.pem
*.key

# Ansible
ansible/group_vars/vault.yml
ansible/group_vars/**/vault.yml
ansible/**/*.retry
ansible/inventory/*.local.ini
ansible/group_vars/all/local.yml

# OS / Editor
.DS_Store
.vscode/

# Ansible local inventory
*.local.ini
